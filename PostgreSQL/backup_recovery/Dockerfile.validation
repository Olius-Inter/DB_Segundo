FROM postgres:16.15-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && python3 -m venv /opt/recovery-venv \
    && /opt/recovery-venv/bin/python -m pip install --no-cache-dir coverage==7.10.7 \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/recovery-venv/bin:${PATH}"
# initdb recusa execução como root; ambos os clusters são criados por postgres.
USER postgres
WORKDIR /workspace
