# Copie para .env nesta pasta. Nunca use estes marcadores como segredos reais.
AIRFLOW_METADATA_PASSWORD=SUBSTITUIR_POR_HEX_ALEATORIO
AIRFLOW_FERNET_KEY=SUBSTITUIR_POR_CHAVE_FERNET
AIRFLOW_JWT_SECRET=SUBSTITUIR_POR_HEX_ALEATORIO
OLIUS_LEGACY_HOST=SEU_HOST
OLIUS_LEGACY_PORT=26714
OLIUS_LEGACY_DATABASE=banco_olius
# Caminhos absolutos locais; no Windows use C:/... e aspas se houver espacos.
OLIUS_LEGACY_CA_FILE=C:/caminho/ca.pem
OLIUS_LEGACY_PGPASS_FILE=C:/caminho/pgpass-exclusivo-legado.conf
# Chave Fernet diferente de AIRFLOW_FERNET_KEY, mantida fora do Git/staging.
OLIUS_CREDENTIAL_KEY_FILE=C:/caminho-protegido/etl-credentials.key
OLIUS_ETL_LOAD_ENABLED=false
OLIUS_ETL_ARCHIVE_ENABLED=false
# Necessarios apenas com compose.archive.yaml; a chave deve ficar separada das saidas.
OLIUS_HISTORY_KEY_FILE=C:/caminho-protegido/history.key
OLIUS_HISTORY_PRIVATE_DIR=C:/pasta-protegida/01_Arquivos_Criptografados
OLIUS_HISTORY_BACKUP_DIR=C:/OLIUS_Privado/HistoricoLegado/01_Backup_Criptografado
OLIUS_HISTORY_REPORT_DIR=C:/pasta-compartilhada/02_Relatorios
OLIUS_ETL_ARCHIVE_VERSION=1
# Preencher com YYYY-MM-DD quando a avaliacao final ocorrer.
OLIUS_ETL_EVALUATION_DATE=
# Necessarios somente com compose.load.yaml e carga explicitamente habilitada.
OLIUS_TARGET_HOST=SEU_HOST_DESTINO
OLIUS_TARGET_PORT=26714
OLIUS_TARGET_DATABASE=SEU_BANCO_DESTINO
OLIUS_TARGET_USER=SUA_CONTA_DE_MANUTENCAO_AUTORIZADA
OLIUS_TARGET_CA_FILE=C:/caminho/ca-destino.pem
OLIUS_TARGET_PGPASS_FILE=C:/caminho/pgpass-destino.conf
OLIUS_ETL_CONFIRMED_TARGET=SEU_HOST_DESTINO:26714/SEU_BANCO_DESTINO

# Somente caminhos: nunca colocar dados pessoais ou conteúdo de chaves neste arquivo.
OLIUS_LEGACY_CPF_KEY_HOST_FILE=C:/caminho-protegido/cpf-legado.txt
OLIUS_B2B_COMPLEMENT_HOST_FILE=C:/caminho-protegido/B2B.csv
OLIUS_DRIVER_COMPLEMENT_HOST_FILE=C:/caminho-protegido/MOTORISTAS.csv
OLIUS_ETL_EXTENDED_LOAD_ENABLED=false
