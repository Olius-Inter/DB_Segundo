# Copie para .env e preencha. Não versionar o .env.
# Redis local (docker compose): localhost/6379, sem senha, REDIS_SSL=false.
# Upstash (produção): host e senha do painel (aba TCP), porta 6379, REDIS_SSL=true.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Dados de DEMONSTRAÇÃO; nunca true em produção.
OLIUS_SEED=false
OLIUS_SEED_CLEAR=false

# Token do rebuild manual (POST /api/ranking/rebuild), cabeçalho X-Service-Token.
# Gere com: openssl rand -hex 32. Vazio = rebuild manual bloqueado.
OLIUS_SERVICE_TOKEN=

# Origens web liberadas no CORS (separe por vírgula). O app Android não precisa.
OLIUS_ALLOWED_ORIGINS=

# Conta somente leitura desta API (ver BANCO_ACESSO_API_REDIS.md).
# ex.: jdbc:postgresql://host:5432/olius?sslmode=require
OLIUS_DATABASE_URL=
OLIUS_DATABASE_USER=
OLIUS_DATABASE_PASSWORD=
OLIUS_REBUILD_ENABLED=true
# Duration do Spring: 5m, 30s, 1h
OLIUS_REBUILD_INTERVAL=5m

# URL da Core vista por ESTA API (local: http://localhost:8080; produção: URL HTTPS da Core).
OLIUS_CORE_BASE_URL=

# Swagger privado; use true só localmente.
OLIUS_API_DOCS_ENABLED=false
